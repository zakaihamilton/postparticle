# Copy to .env.local. Use different buckets/keys for preview and production.
APP_ORIGIN=http://localhost:3000
STORAGE_DRIVER=spaces
CONTROL_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
CONTROL_SPACES_REGION=nyc3
CONTROL_SPACES_BUCKET=your-private-control-bucket
CONTROL_SPACES_ACCESS_KEY=
CONTROL_SPACES_SECRET_KEY=
PROJECT_DEMO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
PROJECT_DEMO_SPACES_REGION=nyc3
PROJECT_DEMO_SPACES_BUCKET=your-demo-content-bucket
PROJECT_DEMO_SPACES_ACCESS_KEY=
PROJECT_DEMO_SPACES_SECRET_KEY=
# Optional full bucket CDN URL, without a trailing slash
PROJECT_DEMO_MEDIA_BASE_URL=
# Production login stays disabled until the documented Vercel WAF rule is enabled.
LOGIN_RATE_LIMIT_CONFIGURED=false
