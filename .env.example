# Copy to .env.local. Use different buckets/keys for preview and production.
APP_ORIGIN=http://localhost:3000
STORAGE_DRIVER=spaces
CONTROL_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
CONTROL_SPACES_REGION=nyc3
CONTROL_SPACES_BUCKET=your-private-control-bucket
CONTROL_SPACES_ACCESS_KEY=
CONTROL_SPACES_SECRET_KEY=
CONTENT_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
CONTENT_SPACES_REGION=nyc3
CONTENT_SPACES_BUCKET=your-private-content-bucket
CONTENT_SPACES_ACCESS_KEY=
CONTENT_SPACES_SECRET_KEY=
# Optional full content bucket CDN URL, without a trailing slash
CONTENT_MEDIA_BASE_URL=
# Production login stays disabled until the documented Vercel WAF rule is enabled.
LOGIN_RATE_LIMIT_CONFIGURED=false
# Optional one-time production bootstrap token; remove it after creating the first admin.
# Generate with: openssl rand -hex 32
# INITIAL_ADMIN_BOOTSTRAP_TOKEN=
